<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.2.0.0" name="CWriteWatcher.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker：默认以当前用户权限运行（标准模式）。
             精确模式（ETW）通过 ShellExecute(runas) 或任务计划 /RL HIGHEST 提权启动。 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- 支持 > 260 字符长路径 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- 允许 UTF-8 作为进程活动代码页 -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <!--
        注意：这里**不要**再写 dpiAware / dpiAwareness。
        WinForms 项目通过 <ApplicationHighDpiMode> 项目属性 + Application.SetHighDpiMode()
        统一配置，清单里重复声明会触发 WFAC010 警告。
      -->
    </windowsSettings>
  </application>

</assembly>
